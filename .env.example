# Deriv App credentials (register at developers.deriv.com)
# DERIV_APP_ID is the OAuth client_id - it is public and appears in the auth URL.
DERIV_APP_ID=
# DERIV_AFFILIATE_TOKEN is a secret - set it in the Vercel dashboard, never commit it.
DERIV_AFFILIATE_TOKEN=
DERIV_AFFILIATE_CAMPAIGN=reshare_site

# OAuth endpoints (Deriv production)
DERIV_OAUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
DERIV_API_BASE=https://api.derivws.com

# Must exactly match the origin of the redirect URL registered with Deriv.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production (set in Vercel, not here): https://voltix.com

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=
